Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Update Topic:
        Value: /map_updates
    - Class: rviz_default_plugins/RobotModel
      Name: Robot model (official go2_description)
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Frame Timeout: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: L1 cloud (live, odom)
      Enabled: true
      Topic:
        Value: /go2/cloud_deskewed
        Depth: 5
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: L1 cropped + merged 0.3 s
      Enabled: false
      Topic:
        Value: /l1_cloud_merged
        Depth: 5
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 255; 170; 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/LaserScan
      Name: 2D scan (/scan)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Use Fixed Frame: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_footprint
      Distance: 6
      Pitch: 0.9
      Yaw: 3.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 1400
  Height: 900
